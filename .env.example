# ===== 服务端配置（复制为 .env 后填写真实值；.env 不会被提交，也不会下发到前端）=====

# 本地前端服务端口
PORT=8787

# 上游应用 API
ADP_BASE_URL=http://101.33.81.237:8088/v1
ADP_CHAT_PATH=/chat-messages
# 鉴权方式：bearer（仅 Header）/ appkey（放请求体）/ bearer+appkey
ADP_AUTH_STYLE=bearer
# API 密钥（请勿提交、请勿写入前端）
ADP_API_KEY=app-xxxxxxxxxxxxxxxx
# 请求体风格：dify（ADP 私有化应用 API）/ openai / adp
ADP_API_STYLE=dify

# 视角对应的 App 变量名（可用 GET /v1/parameters 核实）
ADP_PERSPECTIVE_KEY=user_perspective

# 是否流式返回（true=streaming，false=blocking）
ADP_UPSTREAM_STREAM=true

# 调试：把上游原始返回打印到控制台
ADP_DEBUG=false

# 页面品牌文案
APP_NAME=中山文旅 · 数字档案
APP_SUBTITLE=三重门径，遍览香山风物与人情